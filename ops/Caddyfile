{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /srv
	encode zstd gzip
	header {
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
	@still_have_it path /still-have-it /still-have-it/*
	handle @still_have_it {
		try_files {path} {path}/index.html /still-have-it/index.html
		file_server
	}
	file_server
}

:8082 {
	reverse_proxy authentik:9000
}

:8083 {
	respond "Immich authenticated gateway is not configured yet." 503
}
